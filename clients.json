{
  "_comment": "Ocelot client + accounting config. Single source of truth for: eHub Account Reference -> Xero contact mapping, revenue/cost account codes, per-client contracted rates, and (future) payroll/overhead allocation. Edit this, not code. Any eHub Account Reference NOT listed here is surfaced on-screen as 'unmapped', never silently dropped.",

  "revenueAccounts": {
    "4200": "Freight Revenue - Outbound",
    "4210": "Freight Revenue - Inbound (confirm name in Xero)",
    "4000": "Warehousing Services",
    "4020": "Management Fees",
    "4100": "Materials Revenue",
    "BG4001": "Technology Fees"
  },
  "revenueAccountRoles": {
    "_comment": "freight column = outbound (4200) only, per validation. 4210 (inbound freight rev) counts as other/total. Discovered via validation: it was the exact $3,156.68 gap in Joymode total billed.",
    "freight": ["4200"],
    "other": ["4000", "4020", "4100", "BG4001", "4210"]
  },
  "costAccounts": {
    "5200": "COS - Freight Outbound",
    "5210": "COS - Freight Inbound",
    "5100": "COS - Warehouse Materials"
  },
  "reconcile": {
    "_comment": "5200 is not reliably contact-coded; per-client carrier cost comes from eHub. Reconcile the eHub carrier-cost total back to Xero 5200 and warn if they differ by more than this fraction.",
    "carrierCostVs5200TolerancePct": 2
  },
  "alerts": {
    "_comment": "Flag a client whose charged-back (eHub adjustments) exceeds this fraction of their carrier cost.",
    "chargedBackVsCarrierCostPct": 3
  },
  "compliance": {
    "_comment": "Freight compliance = effective outbound freight markup (freightBilled/carrierCost - 1) vs contracted freightMarkupPct. Only UNDER-billing is a violation: per-label, residential and intl surcharges ride ON TOP of the base markup, so a compliant client's effective markup is >= contract. Flag only when effective falls this many percentage points BELOW contract (avoids false-flagging the fee headroom).",
    "freightMarkupUnderTolerancePts": 2
  },
  "pnl": {
    "_comment": "Accounts that appear in the Xero P&L income section but are NOT revenue - e.g. payment-processor clearing accounts (card money in transit). Their balance ebbs and flows with settlement timing and Accounting Frontier reconciles them monthly, so they distort revenue/net when they land in Income. The dashboard backs these out of revenue, gross profit and net income so 'Are we making money?' isn't skewed. PROPER FIX is at the source: reclassify them to a balance-sheet clearing account in Xero; then they read 0 here and this has no effect. Match by exact P&L line name.",
    "clearingAccounts": ["Biller Genie Sales Account"]
  },

